{
  "multipart": [
    {
      "apply": {
        "model": "palamod:block/botanist_pot"
      }
    },
    {
      "when": {
        "stage": "seed"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_sprout"
      }
    },
    {
      "when": {
        "stage": "wilted"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_wilted"
      }
    },
    {
      "when": {
        "stage": "bud",
        "plant": "ironwheat"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_ironwheat_bud"
      }
    },
    {
      "when": {
        "stage": "blooming",
        "plant": "ironwheat"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_ironwheat_bloom"
      }
    },
    {
      "when": {
        "stage": "bud",
        "plant": "moonfrost"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_moonfrost_bud"
      }
    },
    {
      "when": {
        "stage": "blooming",
        "plant": "moonfrost"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_moonfrost_bloom"
      }
    },
    {
      "when": {
        "stage": "bud",
        "plant": "sand_coral"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_sand_coral_bud"
      }
    },
    {
      "when": {
        "stage": "blooming",
        "plant": "sand_coral"
      },
      "apply": {
        "model": "palamod:block/botanist_pot_sand_coral_bloom"
      }
    }
  ]
}
