{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "water",
        "model": {
          "type": "minecraft:model",
          "model": "palamod:item/pistol_tank_water"
        }
      },
      {
        "when": "lava",
        "model": {
          "type": "minecraft:model",
          "model": "palamod:item/pistol_tank_lava"
        }
      },
      {
        "when": "fluid",
        "model": {
          "type": "minecraft:model",
          "model": "palamod:item/pistol_tank_fluid"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "palamod:item/pistol_tank"
    }
  }
}
